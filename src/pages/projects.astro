---
import Base from '../layouts/Base.astro';
import { projects, featuredProject, otherProjects } from '../data/projects';
import { site } from '../data/site';
---

<Base title="作品" description="做过的项目：技术栈、关键决策与复盘。">
  <header class="page-head wrap">
    <div class="eyebrow" data-reveal>Projects</div>
    <h1 class="page-title" data-reveal data-reveal-delay="60">作品档案</h1>
    <p class="page-lead" data-reveal data-reveal-delay="100">
      每个项目一页卡片：做了什么、用了什么、以及在哪个决定上卡住过。
      代码都在 GitHub 上，卡片里只留值得复述的部分。
    </p>
    <div class="head-stats mono" data-reveal data-reveal-delay="140">
      <span><b>{projects.length}</b> 个项目</span>
      <span class="sep">·</span>
      <span>全部开源</span>
      <span class="sep">·</span>
      <span>最近更新 {featuredProject.period.split('—').at(-1)?.trim()}</span>
    </div>
  </header>

  <section class="wrap">
    <article class="feature" data-reveal>
      <div class="feature-top mono">
        <span class="feature-idx">01 / Featured</span>
        <span class="feature-status"><i class="live"></i>{featuredProject.status}</span>
      </div>

      <div class="feature-grid">
        <div class="feature-main">
          <h2 class="feature-name serif">{featuredProject.name}</h2>
          <p class="feature-zh">{featuredProject.zh}</p>
          <p class="feature-tagline">{featuredProject.tagline}</p>
          <p class="feature-desc">{featuredProject.desc}</p>

          <div class="stack">
            {featuredProject.stack.map((item) => <span class="chip">{item}</span>)}
          </div>

          <div class="feature-links">
            {featuredProject.repo && (
              <a class="feature-link" href={featuredProject.repo} target="_blank" rel="noreferrer">
                仓库 ↗
              </a>
            )}
            <span class="feature-period mono">{featuredProject.period}</span>
          </div>
        </div>

        <aside class="feature-metric">
          <div class="metric-value serif">{featuredProject.metric?.value}</div>
          <div class="metric-label mono">{featuredProject.metric?.label}</div>
          <div class="metric-rule"></div>
          <p class="metric-note">
            每个判断都写成了可运行的断言，改动前先跑一遍。
          </p>
        </aside>
      </div>

      <div class="highlights">
        {featuredProject.highlights.map((item, index) => (
          <div class="highlight">
            <span class="hl-idx mono">{String(index + 1).padStart(2, '0')}</span>
            <h3 class="hl-title">{item.title}</h3>
            <p class="hl-body">{item.body}</p>
          </div>
        ))}
      </div>
    </article>
  </section>

  <section class="wrap other-section">
    <div class="section-head" data-reveal>
      <h2 class="section-title"><span class="idx mono">02</span>其他项目</h2>
      <a class="arrow-link" href={site.links.github} target="_blank" rel="noreferrer">
        GitHub 全部仓库 <span class="arw">↗</span>
      </a>
    </div>

    <div class="other-grid">
      {otherProjects.map((project, index) => (
        <article class="other-card" data-reveal data-reveal-delay={index * 60}>
          <div class="other-top mono">
            <span class="other-idx">{String(index + 2).padStart(2, '0')}</span>
            <span class="other-status">{project.status}</span>
          </div>
          <h3 class="other-name">{project.name}</h3>
          <p class="other-zh">{project.zh}</p>
          <p class="other-tagline">{project.tagline}</p>

          <ul class="other-points">
            {project.highlights.map((item) => (
              <li>
                <span class="point-title">{item.title}</span>
                <span class="point-body">{item.body}</span>
              </li>
            ))}
          </ul>

          <div class="stack">
            {project.stack.map((item) => <span class="chip">{item}</span>)}
          </div>

          <div class="other-foot">
            <span class="mono">{project.period}</span>
            {project.repo && (
              <a class="arrow-link" href={project.repo} target="_blank" rel="noreferrer">
                仓库 <span class="arw">↗</span>
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="wrap closing">
    <div class="closing-inner" data-reveal>
      <p class="closing-text">
        项目不多，但每个都在跑。<br />
        愿意聊实现细节，或者只是想提一个 issue，都欢迎。
      </p>
      <a class="action-primary" href={site.links.github} target="_blank" rel="noreferrer">
        在 GitHub 找我 <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</Base>

<style>
  .page-head {
    padding-block: clamp(48px, 7vw, 88px) clamp(28px, 4vw, 40px);
  }

  .page-title {
    margin-top: 18px;
    font-size: var(--fs-h1);
  }

  .page-lead {
    margin-top: 18px;
    max-width: 62ch;
    font-size: 0.98rem;
    line-height: 1.9;
    color: var(--paper-dim);
    text-wrap: pretty;
  }

  .head-stats {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 24px;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: var(--paper-faint);
  }

  .head-stats b {
    color: var(--paper);
    font-weight: 500;
  }

  .sep {
    opacity: 0.4;
  }

  /* 主项目 */
  .feature {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background:
      radial-gradient(620px 320px at 88% 0%, rgba(214, 167, 86, 0.07), transparent 68%),
      var(--ink-1);
    padding: clamp(24px, 3.6vw, 40px);
  }

  .feature-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line-soft);
    font-size: 0.65rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--paper-faint);
  }

  .feature-idx {
    color: var(--brass);
    opacity: 0.8;
  }

  .feature-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    letter-spacing: 0.08em;
    text-transform: none;
    color: var(--jade);
  }

  .live {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--jade);
    box-shadow: 0 0 0 0 rgba(125, 167, 154, 0.5);
    animation: pulse 2.8s infinite;
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(125, 167, 154, 0.45);
    }
    70% {
      box-shadow: 0 0 0 7px rgba(125, 167, 154, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(125, 167, 154, 0);
    }
  }

  .feature-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 190px;
    gap: clamp(24px, 4vw, 56px);
    padding-block: 28px 30px;
  }

  .feature-name {
    font-size: clamp(2rem, 4.2vw, 2.9rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--paper-strong);
  }

  .feature-zh {
    margin-top: 8px;
    font-size: 0.86rem;
    color: var(--paper-faint);
    letter-spacing: 0.04em;
  }

  .feature-tagline {
    margin-top: 22px;
    max-width: 40ch;
    font-size: 1.1rem;
    line-height: 1.75;
    color: var(--paper);
    text-wrap: pretty;
  }

  .feature-desc {
    margin-top: 14px;
    max-width: 62ch;
    font-size: 0.9rem;
    line-height: 1.85;
    color: var(--paper-dim);
    text-wrap: pretty;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 22px;
  }

  .feature-links {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 24px;
  }

  .feature-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    border: 1px solid var(--brass-line);
    border-radius: 5px;
    font-size: 0.8rem;
    color: var(--brass);
    transition: background-color 0.25s var(--ease);
  }

  .feature-link:hover {
    background: var(--brass-soft);
  }

  .feature-period {
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: var(--paper-faint);
  }

  .feature-metric {
    border-left: 1px solid var(--line-soft);
    padding-left: 26px;
    align-self: start;
  }

  .metric-value {
    font-size: 2.6rem;
    line-height: 1;
    color: var(--brass);
    font-variant-numeric: tabular-nums;
  }

  .metric-label {
    margin-top: 8px;
    font-size: 0.64rem;
    letter-spacing: 0.14em;
    color: var(--paper-faint);
    text-transform: uppercase;
  }

  .metric-rule {
    height: 1px;
    background: var(--line-soft);
    margin: 18px 0 14px;
  }

  .metric-note {
    font-size: 0.76rem;
    line-height: 1.7;
    color: var(--paper-faint);
  }

  .highlights {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--line-soft);
    border-top: 1px solid var(--line-soft);
    margin-inline: calc(clamp(24px, 3.6vw, 40px) * -1);
    margin-bottom: calc(clamp(24px, 3.6vw, 40px) * -1);
    margin-top: 0;
  }

  .highlight {
    padding: 24px clamp(24px, 3.6vw, 40px);
    background: var(--ink-1);
    transition: background-color 0.3s var(--ease);
  }

  .highlight:hover {
    background: var(--ink-2);
  }

  .hl-idx {
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    color: var(--brass);
    opacity: 0.6;
  }

  .hl-title {
    margin-top: 8px;
    font-size: 0.98rem;
    color: var(--paper-strong);
  }

  .hl-body {
    margin-top: 8px;
    font-size: 0.85rem;
    line-height: 1.8;
    color: var(--paper-dim);
    text-wrap: pretty;
  }

  /* 其他项目 */
  .other-section {
    margin-top: clamp(56px, 8vw, 90px);
  }

  .other-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin-top: 26px;
  }

  .other-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 26px 26px 22px;
    background: rgba(255, 255, 255, 0.012);
    transition: border-color 0.3s var(--ease), transform 0.3s var(--ease);
  }

  .other-card:hover {
    border-color: var(--line-strong);
    transform: translateY(-2px);
  }

  .other-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    color: var(--paper-faint);
  }

  .other-idx {
    color: var(--brass);
    opacity: 0.7;
  }

  .other-name {
    margin-top: 16px;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
  }

  .other-zh {
    margin-top: 5px;
    font-size: 0.78rem;
    color: var(--paper-faint);
  }

  .other-tagline {
    margin-top: 14px;
    font-size: 0.92rem;
    line-height: 1.75;
    color: var(--paper);
    text-wrap: pretty;
  }

  .other-points {
    list-style: none;
    margin-top: 18px;
    display: grid;
    gap: 12px;
  }

  .point-title {
    display: block;
    font-size: 0.8rem;
    color: var(--jade);
    letter-spacing: 0.02em;
  }

  .point-body {
    display: block;
    margin-top: 3px;
    font-size: 0.82rem;
    line-height: 1.75;
    color: var(--paper-faint);
    text-wrap: pretty;
  }

  .other-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: auto;
    padding-top: 20px;
    border-top: 1px solid var(--line-soft);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    color: var(--paper-faint);
  }

  /* 收尾 */
  .closing {
    margin-top: clamp(56px, 8vw, 96px);
  }

  .closing-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 26px;
    padding: clamp(40px, 6vw, 64px) 20px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    text-align: center;
  }

  .closing-text {
    font-size: clamp(1.15rem, 2.4vw, 1.55rem);
    line-height: 1.8;
    color: var(--paper-strong);
    text-wrap: balance;
  }

  .action-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 11px 20px;
    border-radius: 6px;
    background: var(--brass);
    color: #14100a;
    font-size: 0.88rem;
    font-weight: 600;
    transition: background-color 0.25s var(--ease), transform 0.25s var(--ease);
  }

  .action-primary:hover {
    background: #e2b566;
    transform: translateY(-1px);
  }

  @media (max-width: 860px) {
    .feature-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .feature-metric {
      border-left: 0;
      border-top: 1px solid var(--line-soft);
      padding-left: 0;
      padding-top: 20px;
      display: grid;
      grid-template-columns: auto auto 1fr;
      align-items: baseline;
      gap: 12px;
    }
    .metric-rule {
      display: none;
    }
    .metric-note {
      grid-column: 1 / -1;
    }
    .highlights {
      grid-template-columns: minmax(0, 1fr);
    }
    .other-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
