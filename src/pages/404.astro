---
import Base from '../layouts/Base.astro';
---

<Base title="页面不存在" description="请求的页面不存在。" noindex>
  <section class="wrap not-found">
    <div class="code serif" aria-hidden="true">404</div>
    <h1 class="title">这条路径没有内容</h1>
    <p class="desc">
      可能是链接写错了，也可能这条笔记还没写。回到入口重新找一次。
    </p>
    <div class="actions">
      <a class="action-primary" href="/">回到首页 <span aria-hidden="true">→</span></a>
      <a class="action-ghost" href="/knowledge/">知识空间</a>
    </div>
  </section>
</Base>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    min-height: 62vh;
    padding-block: 60px;
  }

  .code {
    font-size: clamp(4.5rem, 15vw, 9rem);
    line-height: 0.9;
    color: transparent;
    -webkit-text-stroke: 1px var(--line-strong);
    letter-spacing: 0.02em;
  }

  .title {
    margin-top: 22px;
    font-size: clamp(1.5rem, 3.4vw, 2rem);
  }

  .desc {
    margin-top: 14px;
    max-width: 46ch;
    font-size: 0.94rem;
    line-height: 1.9;
    color: var(--paper-dim);
  }

  .actions {
    display: flex;
    gap: 12px;
    margin-top: 30px;
    flex-wrap: wrap;
  }

  .action-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 6px;
    background: var(--brass);
    color: #14100a;
    font-size: 0.88rem;
    font-weight: 600;
  }

  .action-ghost {
    display: inline-flex;
    align-items: center;
    padding: 9px 16px;
    border: 1px solid var(--line);
    border-radius: 6px;
    font-size: 0.86rem;
    color: var(--paper-dim);
  }

  .action-ghost:hover {
    color: var(--paper-strong);
    border-color: var(--line-strong);
  }
</style>
