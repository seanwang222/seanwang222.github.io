---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import {
  getNotes,
  getBacklinks,
  getOutgoing,
  getTags,
  readingTime,
  noteHref,
} from '../../lib/notes';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((note, index) => ({
    params: { slug: note.id },
    props: {
      note,
      newer: notes[index - 1]?.id ?? null,
      older: notes[index + 1]?.id ?? null,
    },
  }));
}

const { note, newer, older } = Astro.props;
const notes = await getNotes();
const { Content, headings } = await render(note);

const iso = note.data.date.toISOString().slice(0, 10);
const minutes = readingTime(note.body ?? '');
const backlinks = getBacklinks(notes, note.id);
const outgoing = getOutgoing(notes, note.id);
const newerNote = newer ? notes.find((item) => item.id === newer) : null;
const olderNote = older ? notes.find((item) => item.id === older) : null;
const toc = headings.filter((heading) => heading.depth <= 3);
const related = notes
  .filter(
    (item) =>
      item.id !== note.id &&
      item.data.tags.some((tag) => note.data.tags.includes(tag))
  )
  .slice(0, 3);
const allTags = getTags(notes);
---

<Base title={note.data.title} description={note.data.summary} type="article">
  <div class="progress" data-progress aria-hidden="true"></div>

  <article class="article wrap">
    <header class="article-head">
      <nav class="crumbs mono" aria-label="面包屑">
        <a href="/knowledge/">知识空间</a>
        <span class="slash">/</span>
        <span class="mono">{note.data.kind === 'essay' ? 'essay' : 'note'}</span>
      </nav>

      <div class="tag-row">
        {note.data.tags.map((tag) => (
          <a class="chip" href={`/knowledge/?tag=${encodeURIComponent(tag)}`}>{tag}</a>
        ))}
      </div>

      <h1 class="article-title">{note.data.title}</h1>
      <p class="article-summary">{note.data.summary}</p>

      <div class="article-meta mono">
        <time datetime={iso}>{iso.replace(/-/g, '.')}</time>
        <span class="sep">·</span>
        <span>{minutes} 分钟</span>
        {note.data.updated && (
          <>
            <span class="sep">·</span>
            <span>更新于 {note.data.updated.toISOString().slice(0, 10).replace(/-/g, '.')}</span>
          </>
        )}
        {note.data.source && (
          <>
            <span class="sep">·</span>
            <span>来自 {note.data.source}</span>
          </>
        )}
      </div>
    </header>

    <div class="article-grid">
      <div class="article-body">
        <div class="prose">
          <Content />
        </div>

        <section class="links-block">
          <div class="links-head">
            <h2 class="links-title">双向链接</h2>
            <span class="mono micro faint">
              {backlinks.length} 条指入 · {outgoing.length} 条指回
            </span>
          </div>

          <div class="links-cols">
            <div class="links-col">
              <div class="col-label mono">指向此页</div>
              {backlinks.length === 0 ? (
                <p class="links-empty">还没有其他笔记引用它。</p>
              ) : (
                <ul class="links-list">
                  {backlinks.map((item) => (
                    <li>
                      <a href={noteHref(item.id)}>
                        <span class="link-title">{item.data.title}</span>
                        <span class="link-date mono">{item.data.date.toISOString().slice(5, 10)}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>

            <div class="links-col">
              <div class="col-label mono">从此页出发</div>
              {outgoing.length === 0 ? (
                <p class="links-empty">这条笔记没有指向别处。</p>
              ) : (
                <ul class="links-list">
                  {outgoing.map((item) => (
                    <li>
                      <a href={noteHref(item.id)}>
                        <span class="link-title">{item.data.title}</span>
                        <span class="link-date mono">{item.data.date.toISOString().slice(5, 10)}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        </section>

        {related.length > 0 && (
          <section class="related">
            <div class="col-label mono">同一标签下</div>
            <ul class="related-list">
              {related.map((item) => (
                <li>
                  <a href={noteHref(item.id)}>{item.data.title}</a>
                  <span class="mono micro faint">{item.data.tags.slice(0, 2).join(' / ')}</span>
                </li>
              ))}
            </ul>
          </section>
        )}

        <nav class="pager" aria-label="上下篇">
          {olderNote ? (
            <a class="pager-item prev" href={noteHref(olderNote.id)}>
              <span class="pager-label mono">← 更早</span>
              <span class="pager-title">{olderNote.data.title}</span>
            </a>
          ) : (
            <span class="pager-item empty-slot" />
          )}
          {newerNote ? (
            <a class="pager-item next" href={noteHref(newerNote.id)}>
              <span class="pager-label mono">更新 →</span>
              <span class="pager-title">{newerNote.data.title}</span>
            </a>
          ) : (
            <span class="pager-item empty-slot" />
          )}
        </nav>
      </div>

      <aside class="article-aside">
        {toc.length > 0 && (
          <div class="toc">
            <div class="aside-label mono">目录</div>
            <ul class="toc-list">
              {toc.map((heading) => (
                <li class:list={[`d${heading.depth}`]}>
                  <a href={`#${heading.slug}`} data-toc-link={heading.slug}>{heading.text}</a>
                </li>
              ))}
            </ul>
          </div>
        )}

        <div class="aside-meta">
          <div class="aside-label mono">标签</div>
          <div class="aside-tags">
            {note.data.tags.map((tag) => {
              const count = allTags.find((entry) => entry.tag === tag)?.count ?? 1;
              return (
                <a class="aside-tag" href={`/knowledge/?tag=${encodeURIComponent(tag)}`}>
                  <span>{tag}</span>
                  <span class="n mono">{count}</span>
                </a>
              );
            })}
          </div>
        </div>

        <div class="aside-actions">
          <a class="aside-btn" href={site.links.github} target="_blank" rel="noreferrer">
            GitHub ↗
          </a>
          <a class="aside-btn" href={`mailto:${site.email}?subject=${encodeURIComponent(`关于《${note.data.title}》`)}`}>
            讨论
          </a>
        </div>
      </aside>
    </div>
  </article>
</Base>

<script>
  const progress = document.querySelector<HTMLElement>('[data-progress]');
  const article = document.querySelector<HTMLElement>('.article-body');
  const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];

  function onScroll() {
    if (!progress || !article) return;
    const rect = article.getBoundingClientRect();
    const total = rect.height - window.innerHeight * 0.4;
    const passed = Math.min(Math.max(-rect.top + 120, 0), Math.max(total, 1));
    progress.style.transform = `scaleX(${passed / Math.max(total, 1)})`;
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  if (tocLinks.length) {
    const headings = tocLinks
      .map((link) => document.getElementById(link.dataset.tocLink ?? ''))
      .filter((el): el is HTMLElement => Boolean(el));

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const id = entry.target.id;
          tocLinks.forEach((link) => {
            link.classList.toggle('active', link.dataset.tocLink === id);
          });
        }
      },
      { rootMargin: '-96px 0px -68% 0px', threshold: 0 }
    );
    headings.forEach((heading) => observer.observe(heading));
  }
</script>

<style>
  .progress {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 130;
    width: 100%;
    height: 2px;
    background: var(--brass);
    transform: scaleX(0);
    transform-origin: 0 50%;
    opacity: 0.85;
    pointer-events: none;
  }

  .article {
    padding-top: clamp(34px, 5vw, 60px);
  }

  .article-head {
    max-width: 78ch;
    padding-bottom: 30px;
    border-bottom: 1px solid var(--line);
  }

  .crumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    color: var(--paper-faint);
  }

  .crumbs a {
    color: var(--paper-dim);
    transition: color 0.2s var(--ease);
  }

  .crumbs a:hover {
    color: var(--brass);
  }

  .slash {
    opacity: 0.4;
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 22px;
  }

  .article-title {
    margin-top: 16px;
    font-size: clamp(1.85rem, 3.8vw, 2.7rem);
    line-height: 1.34;
    letter-spacing: -0.022em;
  }

  .article-summary {
    margin-top: 18px;
    max-width: 66ch;
    font-size: 1rem;
    line-height: 1.9;
    color: var(--paper-dim);
    text-wrap: pretty;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 24px;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    color: var(--paper-faint);
  }

  .article-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 216px;
    gap: clamp(32px, 5vw, 72px);
    padding-top: 42px;
  }

  .links-block {
    margin-top: clamp(52px, 7vw, 84px);
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }

  .links-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 22px;
  }

  .links-title {
    font-size: 1rem;
    letter-spacing: 0.02em;
  }

  .links-cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
  }

  .col-label {
    font-size: 0.63rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--paper-faint);
    margin-bottom: 12px;
  }

  .links-empty {
    font-size: 0.85rem;
    color: var(--paper-faint);
  }

  .links-list {
    list-style: none;
    display: grid;
    gap: 2px;
  }

  .links-list a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 9px 10px 9px 0;
    border-bottom: 1px solid var(--line-soft);
    transition: color 0.25s var(--ease), padding-left 0.3s var(--ease);
  }

  .link-title {
    font-size: 0.9rem;
    color: var(--paper);
    transition: color 0.25s var(--ease);
  }

  .link-date {
    font-size: 0.64rem;
    color: var(--paper-faint);
    flex: none;
  }

  .links-list a:hover {
    padding-left: 6px;
  }

  .links-list a:hover .link-title {
    color: var(--brass);
  }

  .related {
    margin-top: 44px;
  }

  .related-list {
    list-style: none;
    display: grid;
    gap: 10px;
  }

  .related-list li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 10px;
    border-bottom: 1px dashed var(--line-soft);
    font-size: 0.9rem;
  }

  .related-list a {
    color: var(--paper-dim);
    transition: color 0.25s var(--ease);
  }

  .related-list a:hover {
    color: var(--brass);
  }

  .pager {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: clamp(48px, 6vw, 72px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--line-soft);
  }

  .pager-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px;
    background: var(--ink-0);
    transition: background-color 0.3s var(--ease);
  }

  .pager-item.next {
    text-align: right;
    align-items: flex-end;
  }

  .pager-item:not(.empty-slot):hover {
    background: var(--ink-2);
  }

  .pager-label {
    font-size: 0.63rem;
    letter-spacing: 0.12em;
    color: var(--paper-faint);
  }

  .pager-title {
    font-size: 0.94rem;
    color: var(--paper);
    line-height: 1.6;
    transition: color 0.25s var(--ease);
  }

  .pager-item:hover .pager-title {
    color: var(--brass);
  }

  .empty-slot {
    background: transparent;
  }

  .article-aside {
    position: sticky;
    top: 96px;
    align-self: start;
    display: grid;
    gap: 30px;
  }

  .aside-label {
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--paper-faint);
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line-soft);
    margin-bottom: 12px;
  }

  .toc-list {
    list-style: none;
    display: grid;
    gap: 8px;
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .toc-list li.d3 {
    padding-left: 12px;
    font-size: 0.78rem;
  }

  .toc-list a {
    color: var(--paper-faint);
    transition: color 0.2s var(--ease);
    display: block;
    border-left: 1px solid transparent;
    padding-left: 8px;
    margin-left: -9px;
  }

  .toc-list a:hover {
    color: var(--paper);
  }

  .toc-list a.active {
    color: var(--brass);
    border-left-color: var(--brass-line);
  }

  .aside-tags {
    display: grid;
    gap: 1px;
  }

  .aside-tag {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 0;
    font-size: 0.8rem;
    color: var(--paper-dim);
    border-bottom: 1px dashed var(--line-soft);
    transition: color 0.2s var(--ease);
  }

  .aside-tag:hover {
    color: var(--brass);
  }

  .aside-tag .n {
    font-size: 0.62rem;
    color: var(--paper-faint);
  }

  .aside-actions {
    display: grid;
    gap: 8px;
  }

  .aside-btn {
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: 6px;
    font-size: 0.76rem;
    color: var(--paper-dim);
    text-align: center;
    transition: color 0.25s var(--ease), border-color 0.25s var(--ease);
  }

  .aside-btn:hover {
    color: var(--brass);
    border-color: var(--brass-line);
  }

  .micro {
    font-size: 0.64rem;
    letter-spacing: 0.08em;
  }

  @media (max-width: 900px) {
    .article-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .article-aside {
      display: none;
    }
    .links-cols {
      grid-template-columns: minmax(0, 1fr);
      gap: 26px;
    }
  }

  @media (max-width: 560px) {
    .pager {
      grid-template-columns: minmax(0, 1fr);
    }
    .pager-item.next {
      text-align: left;
      align-items: flex-start;
    }
    .empty-slot {
      display: none;
    }
  }
</style>
