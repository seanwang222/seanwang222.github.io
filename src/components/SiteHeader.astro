---
import { site } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href.replace(/\/$/, ''));
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label={`${site.name} 首页`}>
      <span class="monogram serif">SW</span>
      <span class="brand-text">
        <span class="brand-name">{site.name}</span>
        <span class="brand-handle mono">@{site.handle}</span>
      </span>
    </a>

    <nav class="nav" aria-label="主导航">
      {site.nav.map((item) => (
        <a href={item.href} class:list={['nav-link', { active: isActive(item.href) }]}>
          <span class="nav-label">{item.label}</span>
          <span class="nav-en mono">{item.en}</span>
        </a>
      ))}
    </nav>

    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-nav">
      <span class="menu-lines" aria-hidden="true"><i></i><i></i></span>
      <span class="sr-only">打开导航</span>
    </button>
  </div>

  <div class="mobile-nav" id="mobile-nav" hidden>
    {site.nav.map((item) => (
      <a href={item.href} class:list={['mobile-link', { active: isActive(item.href) }]}>
        <span>{item.label}</span>
        <span class="mono faint">{item.en}</span>
      </a>
    ))}
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const panel = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    if (panel) panel.hidden = open;
    document.body.style.overflow = open ? '' : 'hidden';
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(8, 9, 10, 0.78);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-bottom: 1px solid var(--line-soft);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 66px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    min-width: 0;
  }

  .monogram {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    flex: none;
    font-size: 0.82rem;
    letter-spacing: 0.02em;
    color: var(--brass);
    border: 1px solid var(--brass-line);
    border-radius: 6px;
    background: rgba(214, 167, 86, 0.05);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .brand-name {
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--paper-strong);
  }

  .brand-handle {
    font-size: 0.66rem;
    color: var(--paper-faint);
    letter-spacing: 0.06em;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(16px, 2.4vw, 30px);
  }

  .nav-link {
    display: inline-flex;
    flex-direction: column;
    gap: 1px;
    padding-block: 6px;
    color: var(--paper-dim);
    transition: color 0.25s var(--ease);
    position: relative;
  }

  .nav-label {
    font-size: 0.83rem;
    letter-spacing: 0.05em;
  }

  .nav-en {
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--paper-faint);
    opacity: 0.75;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--paper-strong);
  }

  .nav-link.active .nav-en {
    color: var(--brass);
    opacity: 1;
  }

  .nav-link.active::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -8px;
    height: 1px;
    background: var(--brass);
    opacity: 0.75;
  }

  .menu-btn {
    display: none;
    width: 38px;
    height: 38px;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .menu-lines {
    display: grid;
    gap: 5px;
    width: 16px;
  }

  .menu-lines i {
    display: block;
    height: 1px;
    background: var(--paper-dim);
    transition: transform 0.25s var(--ease);
  }

  .menu-btn[aria-expanded="true"] .menu-lines i:first-child {
    transform: translateY(3px) rotate(45deg);
  }

  .menu-btn[aria-expanded="true"] .menu-lines i:last-child {
    transform: translateY(-3px) rotate(-45deg);
  }

  .mobile-nav {
    display: none;
    flex-direction: column;
    padding: 6px var(--gutter) 22px;
    border-top: 1px solid var(--line-soft);
  }

  .mobile-link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 13px 0;
    border-bottom: 1px solid var(--line-soft);
    font-size: 0.95rem;
    color: var(--paper-dim);
  }

  .mobile-link.active {
    color: var(--brass);
  }

  .mobile-link .mono {
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  @media (max-width: 820px) {
    .nav {
      display: none;
    }
    .menu-btn {
      display: grid;
    }
    .mobile-nav {
      display: flex;
    }
    .mobile-nav[hidden] {
      display: none;
    }
  }
</style>
